       <item>
        <widget class="QPushButton" name="PathChoose_pushButton">
         <property name="styleSheet">
          <string notr="true">/*按钮普通态*/
QPushButton
{
    /*字体为微软雅黑*/
    font-family:Microsoft Yahei;
    /*字体大小为20点*/
    font-size:20pt;
    /*字体颜色为白色*/    
    color:white;
    /*背景颜色*/  
     background:qlineargradient(x1:0 , y1:0 , x2:1 , y2:0,
							stop:0   rgb(9, 251, 255),
                                 stop:0.5    rgb(154, 197, 252),
                                 stop:1   rgb(211, 195, 252));
/*background: qlineargradient(x1:0, y1:0, x2:1, y2:0,stop:0 #497BF0,stop:1 #1FB6F6);*/
    /*边框圆角半径为8像素*/ 
    border-radius:8px;
}

/*按钮停留态*/
QPushButton:hover
{
background:qlineargradient(x1:0 , y1:0 , x2:1 , y2:0,
							stop:0   rgb(159, 224, 255),
                                 stop:0.5    rgb(136, 168, 250),
                                 stop:1   rgb(15, 93, 192));
}

/*按钮按下态*/
QPushButton:pressed
{
    background:qlineargradient(x1:0 , y1:0 , x2:1 , y2:0,
							stop:0   rgb(107, 232, 207),
                                 stop:0.5     rgb(159, 224, 255),
                                 stop:1   rgb(211, 195, 252));
    /*左内边距为3像素，让按下时字向右移动3像素*/  
    padding-left:3px;
    /*上内边距为3像素，让按下时字向下移动3像素*/  
    padding-top:3px;
}
</string>
         </property>
         <property name="text">
          <string>路径查询</string>
         </property>
        </widget>
       </item>
